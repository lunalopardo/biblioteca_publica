{
  "info": {
    "name": "Biblioteca Pública - Web API (JWT)",
    "description": "Pruebas de la Web API de Biblioteca Pública.\n\n1. Ejecutar primero **Autenticación → Login administrador** (y **Login empleado** para la prueba de 403): guardan el JWT en las variables `token` y `tokenEmpleado`.\n2. El resto de los pedidos heredan la autenticación de la colección: `Authorization: Bearer {{token}}`.\n\n`baseUrl` apunta a http://localhost:5288 (perfil http de launchSettings.json).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5288"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenEmpleado",
      "value": ""
    },
    {
      "key": "idLibro",
      "value": "1"
    },
    {
      "key": "idAfiliado",
      "value": "1"
    },
    {
      "key": "idEjemplar",
      "value": "1"
    },
    {
      "key": "idPrestamo",
      "value": "1"
    },
    {
      "key": "fechaDevolucionPactada",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "pm.test(\"Devuelve un token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el JWT del administrador y lo guarda en {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin\",\n  \"password\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login empleado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenEmpleado\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el JWT del empleado y lo guarda en {{tokenEmpleado}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"empleado\",\n  \"password\": \"empleado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login con contraseña incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Credenciales inválidas: 401 sin token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Libros",
      "item": [
        {
          "name": "Listar libros (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros?buscar=&pagina=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": ""
                },
                {
                  "key": "pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Catálogo paginado por servidor, con búsqueda opcional."
          }
        },
        {
          "name": "Detalle de un libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros/{{idLibro}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros",
                "{{idLibro}}"
              ]
            },
            "description": "Incluye géneros, cantidad de ejemplares y disponibles."
          }
        },
        {
          "name": "Libro inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros",
                "999999"
              ]
            },
            "description": "404 en JSON."
          }
        }
      ]
    },
    {
      "name": "3. Afiliados",
      "item": [
        {
          "name": "Listar afiliados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/afiliados?buscar=&pagina=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "afiliados"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": ""
                },
                {
                  "key": "pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Paginado, con búsqueda por nombre, apellido o email."
          }
        },
        {
          "name": "Detalle de un afiliado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/afiliados/{{idAfiliado}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "afiliados",
                "{{idAfiliado}}"
              ]
            },
            "description": "Incluye `sancionado` (préstamos vencidos sin devolver)."
          }
        }
      ]
    },
    {
      "name": "4. Préstamos",
      "item": [
        {
          "name": "Listar préstamos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos?buscar=&pagina=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": ""
                },
                {
                  "key": "pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Primero los no devueltos y los vencidos."
          }
        },
        {
          "name": "Préstamos de un afiliado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos?idAfiliado={{idAfiliado}}&pagina=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos"
              ],
              "query": [
                {
                  "key": "idAfiliado",
                  "value": "{{idAfiliado}}"
                },
                {
                  "key": "pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Filtrado por afiliado."
          }
        },
        {
          "name": "Detalle de un préstamo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/{{idPrestamo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos",
                "{{idPrestamo}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Registrar préstamo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Devolución pactada: 15 días después de hoy, en formato yyyy-mm-dd",
                  "const fecha = new Date();",
                  "fecha.setDate(fecha.getDate() + 15);",
                  "const dosDigitos = n => String(n).padStart(2, \"0\");",
                  "pm.collectionVariables.set(\"fechaDevolucionPactada\", `${fecha.getFullYear()}-${dosDigitos(fecha.getMonth() + 1)}-${dosDigitos(fecha.getDate())}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"idPrestamo\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos"
              ]
            },
            "description": "Aplica las mismas reglas que la página: afiliado sin sanción, suscripción vigente y pagada, ejemplar disponible. Devuelve 201 y guarda el id en {{idPrestamo}}.\n\nCambiar `idAfiliado` e `idEjemplar` por datos válidos de la base.\n\nLa devolución pactada se calcula antes de enviar el pedido: 15 días después de la fecha en que se registra.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idAfiliado\": {{idAfiliado}},\n  \"idEjemplar\": {{idEjemplar}},\n  \"fechaDevolucionPactada\": \"{{fechaDevolucionPactada}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registrar préstamo con datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos"
              ]
            },
            "description": "Faltan afiliado y ejemplar: 400 con los errores de validación.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registrar devolución",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/{{idPrestamo}}/devolucion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos",
                "{{idPrestamo}}",
                "devolucion"
              ]
            },
            "description": "Si hay atraso genera la multa automáticamente."
          }
        },
        {
          "name": "Anular préstamo ya devuelto → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/{{idPrestamo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos",
                "{{idPrestamo}}"
              ]
            },
            "description": "Después de la devolución anterior, el préstamo ya no se puede anular: 409. Con un préstamo en curso responde 200."
          }
        }
      ]
    },
    {
      "name": "5. Seguridad",
      "item": [
        {
          "name": "Sin token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            },
            "description": "Pedido sin header Authorization.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Token inválido → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            },
            "description": "Token con firma incorrecta.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.firma-invalida",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Empleado da de baja un libro → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros/{{idLibro}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros",
                "{{idLibro}}"
              ]
            },
            "description": "La baja del catálogo es solo para administradores. Usa {{tokenEmpleado}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEmpleado}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Endpoint inexistente → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/noexiste",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "noexiste"
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}