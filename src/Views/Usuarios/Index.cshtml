@model IEnumerable<BibliotecaPublica.Models.Usuario>
@{
    ViewData["Title"] = "Listado de Usuarios";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
}

<div class="page-container">
    <div class="page-header">
        <h3>Listado de Usuarios</h3>
        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Usuario
        </a>
    </div>

    <partial name="_Alertas" />

    <form asp-action="Index" method="get" class="search-bar">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Buscar por usuario, nombre, apellido o email..." />

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined icon-inline">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Avatar</th>
                    <th>Usuario</th>
                    <th>Nombre y Apellido</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No se encontraron usuarios.</td>
                    </tr>
                }
                else
                {
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(usuario.Avatar))
                                {
                                    <img src="@usuario.Avatar" alt="Avatar" class="avatar-img-sm" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder-sm">
                                        @(string.IsNullOrEmpty(usuario.Nombre) ? "U" : usuario.Nombre.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </td>
                            <td class="fw-bold">@usuario.NombreUsuario</td>
                            <td>@usuario.Nombre @usuario.Apellido</td>
                            <td>@usuario.Email</td>
                            <td>
                                <span class="badge-role">
                                    @usuario.RolNombre
                                </span>
                            </td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge-active">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Perfil" asp-route-id="@usuario.Id" class="btn-icon" title="Ver detalle">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" />
</div>

@section Scripts {
}