@model BibliotecaPublica.Models.Usuario
@{
    ViewData["Title"] = "Perfil de Usuario";
    bool esMiPerfil = Model.Id == User.ObtenerId();
    bool esAdmin = User.EsAdministrador();
}

<div class="form-card form-card-narrow">
    <div class="card-header-flex">
        <h3>@(esMiPerfil ? "Mi Perfil" : $"Perfil de {Model.NombreUsuario}")</h3>
        <span class="badge badge-role">
            @Model.RolNombre
        </span>
    </div>

    @if (!Model.Activo)
    {
        <div class="alert alert-danger text-center">
            Este usuario se encuentra inactivo en el sistema.
        </div>
    }

    <partial name="_Alertas" />

    <form asp-controller="Usuarios" asp-action="Perfil" asp-route-id="@Model.Id" method="post"
          enctype="multipart/form-data">

        @await Html.PartialAsync("_SelectorImagen", new SelectorImagen
        {
            Titulo = "Foto de Perfil", Nombre = "Foto", Campo = "AvatarFile", CampoEliminar = "EliminarAvatar", Icono = "person",
            ImagenActual = Model.Avatar, Editable = Model.Activo
        })

        <div class="form-group">
            <label class="form-label">Nombre de Usuario</label>
            <input type="text" value="@Model.NombreUsuario" disabled class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Correo Electrónico</label>
            <input asp-for="Email" type="email" class="form-control" required disabled="@(!Model.Activo)" />
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" type="text" class="form-control" required disabled="@(!Model.Activo)" />
            </div>
            <div class="form-group">
                <label asp-for="Apellido" class="form-label">Apellido</label>
                <input asp-for="Apellido" type="text" class="form-control" required disabled="@(!Model.Activo)" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label">Contraseña</label>
            <input asp-for="Password" type="password" class="form-control"
                   placeholder="Dejar en blanco para mantener la actual" disabled="@(!Model.Activo)" />
        </div>

        @if (esAdmin && !esMiPerfil)
        {
            <div class="form-group">
                <label asp-for="Rol" class="form-label">Rol de Usuario</label>
                <select asp-for="Rol" class="form-select" asp-items="Html.GetEnumSelectList<EnRoles>()"
                        disabled="@(!Model.Activo)"></select>
            </div>
        }

        <div class="form-actions">
            @if (esAdmin)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            }
            @if (Model.Activo)
            {
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            }
        </div>

    </form>

    @if (esAdmin && !esMiPerfil)
    {
        if (Model.Activo)
        {
            <div class="action-banner action-banner-danger">
                <div>
                    <strong class="action-banner-title">Dar de baja empleado</strong>
                    <p class="action-banner-desc">Esta acción desactivará al usuario del sistema.</p>
                </div>
                <form asp-controller="Usuarios" asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
                      data-confirmar="¿Está seguro de que desea desactivar a @Model.Nombre @Model.Apellido?"
                      data-confirmar-titulo="Dar de baja usuario" data-confirmar-boton="Sí, dar de baja">
                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                </form>
            </div>
        }
        else
        {
            <div class="action-banner action-banner-success">
                <div>
                    <strong class="action-banner-title">Reactivar empleado</strong>
                    <p class="action-banner-desc">Esta acción le devolverá el acceso al sistema a este usuario.</p>
                </div>
                <form asp-controller="Usuarios" asp-action="Reactivar" asp-route-id="@Model.Id" method="post"
                      data-confirmar="¿Está seguro de que desea reactivar a @Model.Nombre @Model.Apellido?"
                      data-confirmar-titulo="Reactivar usuario" data-confirmar-boton="Sí, reactivar"
                      data-confirmar-tipo="success">
                    <button type="submit" class="btn btn-success btn-sm">Reactivar</button>
                </form>
            </div>
        }
    }
</div>
