@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="form-card form-card-narrow text-center">
    <h2 class="text-danger">Ocurrió un error</h2>
    <p>No se pudo completar la operación. Intentá de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            Código de seguimiento: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
