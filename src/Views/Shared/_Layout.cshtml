<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca Pública</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/formularios.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top navbar-floating-container">
            <div class="container-fluid px-3">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="material-symbols-outlined text-primary" style="font-size: 26px;">local_library</span>
                    <span class="fw-bold">Biblioteca Pública</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-lg-items-center gap-1">
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3" href="#" id="usuariosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Usuarios
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg mt-2" aria-labelledby="usuariosDropdown">
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Usuarios" asp-action="Index">Listar usuarios</a></li>
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Usuarios" asp-action="Create">Registrar usuario</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3" href="#" id="afiliadosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Afiliados
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg mt-2" aria-labelledby="afiliadosDropdown">
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Afiliados" asp-action="Index">Listar afiliados</a></li>
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Afiliados" asp-action="Create">Registrar afiliado</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3" href="#" id="autoresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Autores
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg mt-2" aria-labelledby="autoresDropdown">
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Autores" asp-action="Index">Listar autores</a></li>
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Autores" asp-action="Create">Registrar autor</a></li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li><a class="dropdown-item py-2 px-3 text-muted small fw-bold text-uppercase" asp-controller="Nacionalidades" asp-action="Index">Nacionalidades</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Editoriales" asp-action="Index">Editoriales</a>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3" href="#" id="librosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Libros
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg mt-2" aria-labelledby="librosDropdown">
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Libros" asp-action="Index">Listar libros cargados</a></li>
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Libros" asp-action="Create">Registrar nuevo libro</a></li>
                                        <li><a class="dropdown-item py-2 px-3" asp-controller="Libros" asp-action="BuscarExterno">Importar de Open Library</a></li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li><a class="dropdown-item py-2 px-3 text-muted small fw-bold text-uppercase" asp-controller="Generos" asp-action="Index">Géneros</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav align-items-center gap-3 ms-auto">
                            @{
                                var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                                var avatarUrl = User.FindFirst("Avatar")?.Value;

                                <li class="nav-item">
                                    <a class="d-flex align-items-center text-decoration-none text-dark gap-2 user-profile-link px-2 py-1 rounded-pill"
                                       href="/Usuarios/Perfil/@currentUserId">
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="Avatar" class="rounded-circle border"
                                                 style="width: 34px; height: 34px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 34px; height: 34px; font-size: 13px;">
                                                @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <span class="fw-semibold small d-none d-xl-inline">@fullName</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 px-3 rounded-pill"
                                       asp-controller="Usuarios" asp-action="Logout">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">logout</span>
                                        <span>Salir</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-4 rounded-pill text-white" asp-controller="Usuarios" asp-action="Login">Iniciar Sesión</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 bg-light mt-auto">
        <div class="container small">
            &copy; Biblioteca pública - Laboratorio II - 2026
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>