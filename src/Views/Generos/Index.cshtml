@model IEnumerable<BibliotecaPublica.Models.Genero>

@{
    ViewData["Title"] = "Géneros de Libros";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
}

<div class="form-card form-card-small">
    <div class="card-header-flex">
        <h2>Géneros</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
            + Nuevo Género
        </button>
    </div>

    <partial name="_Alertas" />

    <!-- Buscador -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="form-search-bar">
            <input type="text" name="buscar" value="@filtroActual" class="form-control"
                   placeholder="Buscar género..."/>

            <button type="submit" class="btn btn-outline-secondary">
                <span class="material-symbols-outlined icon-inline">search</span>
                <span>Buscar</span>
            </button>

            @if (!string.IsNullOrEmpty(filtroActual))
            {
                <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
            }
        </div>
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">No se encontraron resultados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var tipo in Model)
                    {
                        <tr>
                            <td>@tipo.Id</td>
                            <td>@tipo.Nombre</td>
                            <td class="text-end">
                                <button type="button" class="btn-icon" title="Editar" data-bs-toggle="modal"
                                        data-bs-target="#modalEditar" data-id="@tipo.Id" data-nombre="@tipo.Nombre">
                                    <span class="material-symbols-outlined">edit</span>
                                </button>

                                <button type="button" class="btn-icon btn-icon-danger" title="Borrar" data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar" data-id="@tipo.Id" data-nombre="@tipo.Nombre">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <partial name="_Paginacion" />
</div>

<!-- Modal crear -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom">Nuevo género</h3>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="Nombre" class="form-label">Nombre</label>
                    <input type="text" name="Nombre" class="form-control" required />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom">Editar género</h3>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit-id" name="Id" />

                <div class="form-group">
                    <label for="edit-nombre" class="form-label">Nombre</label>
                    <input type="text" id="edit-nombre" name="Nombre" class="form-control" required />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom text-danger">Eliminar género</h3>

            <p class="modal-subtitle">¿Estás seguro de que querés eliminar este registro?</p>

            <div class="detail-box">
                <p><strong>Código:</strong> <span id="delete-id-text"></span></p>
                <p><strong>Nombre:</strong> <span id="delete-nombre-text"></span></p>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="delete-id" name="id" />

                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Confirmar baja</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEditar = document.getElementById('modalEditar');
            if (modalEditar) {
                modalEditar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    modalEditar.querySelector('#edit-id').value = button.getAttribute('data-id');
                    modalEditar.querySelector('#edit-nombre').value = button.getAttribute('data-nombre');
                });
            }

            var modalEliminar = document.getElementById('modalEliminar');
            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var nombre = button.getAttribute('data-nombre');

                    modalEliminar.querySelector('#delete-id').value = id;
                    modalEliminar.querySelector('#delete-id-text').textContent = id;
                    modalEliminar.querySelector('#delete-nombre-text').textContent = nombre;
                });
            }
        });
    </script>
}