@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Préstamos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<!-- Todo lo que está dentro de este div lo maneja Vue -->
<div class="page-container" id="prestamos-app" v-cloak data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken"
     data-dias="14">

    <div class="page-header">
        <h3>Préstamos</h3>
        <button type="button" class="btn btn-primary" v-on:click="abrirModalCrear">+ Nuevo préstamo</button>
    </div>

    <div v-if="mensaje" class="alert text-center" :class="mensajeEsError ? 'alert-danger' : 'alert-success'">
        {{ mensaje }}
    </div>

    <form class="search-bar" v-on:submit.prevent="buscarPrestamos">
        <input type="text" v-model="buscar" class="form-control" placeholder="Buscar por afiliado, libro o código..." />
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined">search</span>
            <span>Buscar</span>
        </button>
        <button v-if="buscar" type="button" class="btn btn-outline-secondary"
                v-on:click="limpiarBusqueda">Limpiar</button>
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Afiliado</th>
                    <th>Libro</th>
                    <th>Préstamo</th>
                    <th>Devolución pactada</th>
                    <th>Devuelto el</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="cargando">
                    <td colspan="7" class="text-center py-3">Cargando préstamos...</td>
                </tr>
                <tr v-else-if="prestamos.length === 0">
                    <td colspan="7" class="text-center py-3">No hay préstamos registrados.</td>
                </tr>
                <template v-else>
                    <tr v-for="p in prestamos" :key="p.id">
                        <td class="fw-bold">{{ p.afiliado.apellido }}, {{ p.afiliado.nombre }}</td>
                        <td>
                            {{ p.ejemplar.libro.titulo }}
                            <span class="text-muted small">(Cód. #{{ p.ejemplar.codigoInventario }})</span>
                        </td>
                        <td>{{ formatearFecha(p.fechaPrestamo) }}</td>
                        <td>{{ formatearFecha(p.fechaDevolucionPactada) }}</td>
                        <td>{{ formatearFecha(p.fechaDevolucionReal) }}</td>
                        <td>
                            <span v-if="p.estado === 'Devuelto'" class="badge badge-active">Devuelto</span>
                            <span v-else-if="p.vencido" class="badge badge-inactive">Vencido</span>
                            <span v-else class="badge badge-warning">En progreso</span>
                        </td>
                        <td class="actions-cell">
                            <template v-if="p.estado !== 'Devuelto'">
                                <button type="button" class="btn-icon" title="Registrar devolución"
                                        v-on:click="pedirConfirmacion('devolver', p)">
                                    <span class="material-symbols-outlined">assignment_return</span>
                                </button>
                                <button type="button" class="btn-icon btn-icon-danger" title="Anular préstamo"
                                        v-on:click="pedirConfirmacion('anular', p)">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </template>
                            <span v-else class="text-muted">-</span>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>

    <nav v-if="totalPaginas > 1" class="pagination-container">
        <ul class="pagination-custom">
            <li class="page-item" :class="{ disabled: pagina <= 1 }">
                <a class="page-link" href="#" v-on:click.prevent="irAPagina(pagina - 1)">Anterior</a>
            </li>
            <li v-for="n in totalPaginas" :key="n" class="page-item" :class="{ active: n === pagina }">
                <a class="page-link" href="#" v-on:click.prevent="irAPagina(n)">{{ n }}</a>
            </li>
            <li class="page-item" :class="{ disabled: pagina >= totalPaginas }">
                <a class="page-link" href="#" v-on:click.prevent="irAPagina(pagina + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <!-- Modal: nuevo préstamo -->
    <div v-if="mostrarModal" class="modal-backdrop-custom" v-on:click.self="cerrarModal">
        <form class="modal-panel modal-panel-wide" v-on:submit.prevent="guardarPrestamo">
            <h4 class="mb-3">Nuevo préstamo</h4>

            <div class="form-group">
                <label class="form-label">Afiliado</label>
                <input type="text" v-model="busquedaAfiliado" v-on:input="buscarAfiliados" class="form-control mb-2"
                       placeholder="Buscar por nombre, apellido o email..." />
                <select v-model="form.idAfiliado" size="4" class="form-control">
                    <option v-for="a in afiliados" :key="a.id" :value="a.id">{{ a.text }}</option>
                </select>
                <div v-if="afiliados.length === 0" class="form-hint">No se encontraron afiliados.</div>
            </div>

            <div class="form-group">
                <label class="form-label">Ejemplar disponible</label>
                <input type="text" v-model="busquedaEjemplar" v-on:input="buscarEjemplares" class="form-control mb-2"
                       placeholder="Buscar por título o código..." />
                <select v-model="form.idEjemplar" size="4" class="form-control">
                    <option v-for="e in ejemplares" :key="e.id" :value="e.id">{{ e.text }}</option>
                </select>
                <div v-if="ejemplares.length === 0" class="form-hint">No hay ejemplares disponibles con esa búsqueda.
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Devolución pactada</label>
                <input type="date" v-model="form.fechaDevolucionPactada" :min="manana" class="form-control" required />
            </div>

            <p v-if="errorModal" class="mensaje-error">{{ errorModal }}</p>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" :disabled="guardando">Guardar</button>
                <button type="button" class="btn btn-outline-secondary" v-on:click="cerrarModal">Cancelar</button>
            </div>
        </form>
    </div>

    <!-- Modal: confirmar devolución o anulación -->
    <div v-if="confirmacion" class="modal-backdrop-custom" v-on:click.self="confirmacion = null">
        <div class="modal-panel">
            <h4 class="mb-3">{{ confirmacion.tipo === 'devolver' ? 'Registrar devolución' : 'Anular préstamo' }}</h4>

            <p v-if="confirmacion.tipo === 'devolver'">
                ¿Registrar la devolución de "{{ confirmacion.prestamo.ejemplar.libro.titulo }}"?
                Si está vencido, se genera la multa automáticamente.
            </p>
            <p v-else>
                ¿Anular el préstamo de "{{ confirmacion.prestamo.ejemplar.libro.titulo }}"?
                Usalo solo si se cargó por error.
            </p>

            <div class="form-actions">
                <button type="button" class="btn"
                        :class="confirmacion.tipo === 'devolver' ? 'btn-primary' : 'btn-danger'" v-on:click="confirmar">
                    {{ confirmacion.tipo === 'devolver' ? 'Sí, devolver' : 'Sí, anular' }}
                </button>
                <button type="button" class="btn btn-outline-secondary"
                        v-on:click="confirmacion = null">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3.5.13/dist/vue.global.prod.js"></script>
    <script src="~/js/prestamos.js" asp-append-version="true"></script>
}