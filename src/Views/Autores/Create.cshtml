@model BibliotecaPublica.Models.Autor

@{
    ViewData["Title"] = "Registrar Nuevo Autor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
}

<div class="form-card form-card-narrow">
    <div class="card-header-flex">
        <h2>Registrar Nuevo Autor</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Volver
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
            <span asp-validation-for="Nombre" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Apellido" class="form-label">Apellido</label>
            <input asp-for="Apellido" class="form-control" required />
            <span asp-validation-for="Apellido" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="IdNacionalidad" class="form-label">Nacionalidad</label>
            <select asp-for="IdNacionalidad" class="form-control"
                    asp-items="@(new SelectList(ViewBag.Nacionalidades, "Id", "Nombre"))">
                <option value="">-- Seleccione una nacionalidad --</option>
            </select>
            <span asp-validation-for="IdNacionalidad" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Biografia" class="form-label">Biografía</label>
            <textarea asp-for="Biografia" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Biografia" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label for="fotoFile" class="form-label">Foto del Autor (Opcional)</label>
            <input type="file" id="fotoFile" name="fotoFile" accept="image/*" class="form-control" />
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar Autor</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}