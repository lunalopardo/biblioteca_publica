@model BibliotecaPublica.Models.Autor

@{
    ViewData["Title"] = "Detalles del Autor";
}

<div class="form-card form-card-narrow">
    <div class="card-header-flex">
        <h2>Detalles del Autor</h2>
    </div>

    <div class="avatar-profile-box">
        @if (!string.IsNullOrEmpty(Model.Foto))
        {
            <img src="@Model.Foto" alt="Foto del Autor" class="avatar-img-lg" />
        }
        else
        {
            <div class="avatar-placeholder-lg">
                @(string.IsNullOrEmpty(Model.Nombre) ? "A" : Model.Nombre.Substring(0, 1).ToUpper())
            </div>
        }
    </div>

    <div class="form-group">
        <label class="form-label">Nombre y Apellido</label>
        <div class="form-control-view">@Model.Apellido, @Model.Nombre</div>
    </div>

    <div class="form-group">
        <label class="form-label">Nacionalidad</label>
        <div class="form-control-view">@Model.NacionalidadNombre</div>
    </div>

    <div class="form-group">
        <label class="form-label">Biografía</label>
        <div class="form-control-view">@(string.IsNullOrEmpty(Model.Biografia) ? "Sin biografía" : Model.Biografia)</div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al Listado</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar Autor</a>
    </div>
</div>