@model IEnumerable<BibliotecaPublica.Models.Autor>
@{
    ViewData["Title"] = "Listado de Autores";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";

    var nacionalidades = ViewBag.Nacionalidades as List<Nacionalidad> ?? new List<Nacionalidad>();
    int? idNacionalidad = ViewBag.IdNacionalidad;

    // La paginación tiene que mantener el filtro en los links
    if (idNacionalidad.HasValue)
    {
        ViewData["RutaPaginado"] = new Dictionary<string, string> { ["idNacionalidad"] = idNacionalidad.Value.ToString() };
    }
}

<div class="page-container">
    <div class="page-header">
        <h3>Listado de Autores</h3>
        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Autor
        </a>
    </div>

    <partial name="_Alertas" />

    <form asp-action="Index" method="get" class="search-bar search-bar-filtros">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Buscar por nombre o apellido..." />

        <select name="idNacionalidad" class="form-control" aria-label="Nacionalidad">
            <option value="">Todas las nacionalidades</option>
            @foreach (var n in nacionalidades)
            {
                <option value="@n.Id" selected="@(n.Id == idNacionalidad)">@n.Nombre</option>
            }
        </select>

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined icon-inline">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroActual) || idNacionalidad.HasValue)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Nombre y Apellido</th>
                    <th>Nacionalidad</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-3">No se encontraron autores.</td>
                    </tr>
                }
                else
                {
                    @foreach (var autor in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(autor.Foto))
                                {
                                    <img src="@autor.Foto" alt="Foto" class="avatar-img-sm" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder-sm" title="Sin foto">
                                        <span class="material-symbols-outlined">history_edu</span>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold">@autor.Nombre @autor.Apellido</td>
                            <td>@(string.IsNullOrEmpty(autor.NacionalidadNombre) ? "-" : autor.NacionalidadNombre)</td>

                            <td class="actions-cell">
                                <a asp-action="Details" asp-route-id="@autor.Id" class="btn-icon" title="Ver detalle">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@autor.Id" class="btn-icon" title="Editar">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                @if (User.EsAdministrador())
                                {
                                    <button type="button" class="btn-icon btn-icon-danger" title="Eliminar" data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar" data-id="@autor.Id"
                                            data-nombre="@autor.Nombre @autor.Apellido">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" />
</div>

<!-- Modal de Eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom text-danger">Confirmar Baja</h3>
            <p id="modalTexto" class="modal-subtitle mb-3">¿Está seguro de que desea dar de baja a este autor?</p>

            <form id="formEliminar" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="autorIdEliminar" name="id" />
                <div class="form-actions mt-4">
                    <button type="submit" class="btn btn-danger">Sí, dar de baja</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEliminar = document.getElementById('modalEliminar');
            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var nombre = button.getAttribute('data-nombre');

                    modalEliminar.querySelector('#autorIdEliminar').value = id;
                    modalEliminar.querySelector('#modalTexto').textContent = `¿Está seguro de que desea dar de baja a "${nombre}"?`;
                });
            }
        });
    </script>
}