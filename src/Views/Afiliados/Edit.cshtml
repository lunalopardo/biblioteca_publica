@model BibliotecaPublica.Models.Afiliado

@{
    ViewData["Title"] = "Editar Afiliado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
}

<div class="form-card form-card-narrow">
    <div class="card-header-flex">
        <h2>Editar Afiliado</h2>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
            <span asp-validation-for="Nombre" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Apellido" class="form-label">Apellido</label>
            <input asp-for="Apellido" class="form-control" required />
            <span asp-validation-for="Apellido" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Correo Electrónico</label>
            <input asp-for="Email" type="email" class="form-control" required />
            <span asp-validation-for="Email" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Telefono" class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" required />
            <span asp-validation-for="Telefono" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="FechaAlta" class="form-label">Fecha de Alta</label>
            <input asp-for="FechaAlta" type="date" class="form-control" required />
            <span asp-validation-for="FechaAlta" class="mensaje-error"></span>
        </div>

        <div class="form-group" style="display: flex; gap: 20px; align-items: center; margin-top: 15px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input asp-for="Estado" type="checkbox" /> Cuota al día (Activo)
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input asp-for="Sancionado" type="checkbox" /> Sancionado
            </label>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}