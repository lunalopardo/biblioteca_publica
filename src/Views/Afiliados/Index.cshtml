@model IEnumerable<BibliotecaPublica.Models.Afiliado>
@{
    ViewData["Title"] = "Listado de Afiliados";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";

    // true si la suscripción vigente de hoy está pagada.
    // Si el id no está en el diccionario, no tiene suscripción vigente hoy.
    var estadoSuscripciones = ViewData["EstadoSuscripciones"] as Dictionary<int, bool>
                              ?? new Dictionary<int, bool>();
}

<div class="page-container">
    <div class="page-header">
        <h3>Listado de Afiliados</h3>
        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Afiliado
        </a>
    </div>

    <partial name="_Alertas" />

    <form asp-action="Index" method="get" class="search-bar">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Buscar por nombre, apellido o email..." />

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined icon-inline">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Nombre y Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Fecha de Alta</th>
                    <th>Suscripción</th>
                    <th>Sanción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-3">No se encontraron afiliados registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var afiliado in Model)
                    {
                        <tr>
                            <td class="fw-bold">@afiliado.Apellido, @afiliado.Nombre</td>
                            <td>@afiliado.Email</td>
                            <td>@(string.IsNullOrEmpty(afiliado.Telefono) ? "-" : afiliado.Telefono)</td>
                            <td>@afiliado.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (!estadoSuscripciones.TryGetValue(afiliado.Id, out bool pagada))
                                {
                                    <span class="badge badge-inactive">Sin suscripción</span>
                                }
                                else if (pagada)
                                {
                                    <span class="badge badge-active">Activa</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Pendiente de pago</span>
                                }
                            </td>
                            <td>
                                @if (afiliado.Sancionado)
                                {
                                    <span class="badge badge-inactive">Sancionado</span>
                                }
                                else
                                {
                                    <span class="badge badge-active">Normal</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <a asp-action="Details" asp-route-id="@afiliado.Id" class="btn-icon" title="Ver detalle">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                                <a asp-controller="Suscripciones" asp-action="Index" asp-route-idAfiliado="@afiliado.Id"
                                   class="btn-icon" title="Ver suscripciones">
                                    <span class="material-symbols-outlined">workspace_premium</span>
                                </a>
                                <a asp-controller="Pagos" asp-action="Index" asp-route-idAfiliado="@afiliado.Id"
                                   class="btn-icon" title="Ver pagos">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@afiliado.Id" class="btn-icon" title="Editar">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <button type="button" class="btn-icon btn-icon-danger" title="Eliminar" data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar" data-id="@afiliado.Id"
                                            data-nombre="@afiliado.Apellido, @afiliado.Nombre">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" />
</div>

<!-- Modal de Eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom text-danger">Confirmar Baja</h3>
            <p id="modalTexto" class="modal-subtitle mb-3">¿Está seguro de que desea dar de baja a este afiliado?</p>

            <form id="formEliminar" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="afiliadoIdEliminar" name="id" />
                <div class="form-actions mt-4">
                    <button type="submit" class="btn btn-danger">Sí, dar de baja</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEliminar = document.getElementById('modalEliminar');
            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var nombre = button.getAttribute('data-nombre');

                    modalEliminar.querySelector('#afiliadoIdEliminar').value = id;
                    modalEliminar.querySelector('#modalTexto').textContent = `¿Está seguro de que desea dar de baja a "${nombre}"?`;
                });
            }
        });
    </script>
}