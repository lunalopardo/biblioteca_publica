@model IEnumerable<BibliotecaPublica.Models.Afiliado>
@{
    ViewData["Title"] = "Listado de Afiliados";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
    int paginaActual = (int)(ViewData["PaginaActual"] ?? 1);
    int totalPaginas = (int)(ViewData["TotalPaginas"] ?? 1);
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<div class="page-container">
    <div class="page-header">
        <h3>Listado de Afiliados</h3>
        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Afiliado
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div id="alerta-mensaje" class="alert alert-success text-center">
            @TempData["Mensaje"]
        </div>
    }

    <form asp-action="Index" method="get" class="search-bar">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Buscar por nombre, apellido o email..." />
        
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Nombre y Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Fecha de Alta</th>
                    <th>Estado Cuota</th>
                    <th>Sanción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-3">No se encontraron afiliados registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var afiliado in Model)
                    {
                        <tr>
                            <td class="fw-bold">@afiliado.Apellido, @afiliado.Nombre</td>
                            <td>@afiliado.Email</td>
                            <td>@(string.IsNullOrEmpty(afiliado.Telefono) ? "-" : afiliado.Telefono)</td>
                            <td>@afiliado.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (afiliado.Estado)
                                {
                                    <span class="badge badge-active">Al día</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Adeuda</span>
                                }
                            </td>
                            <td>
                                @if (afiliado.Sancionado)
                                {
                                    <span class="badge badge-inactive">Sancionado</span>
                                }
                                else
                                {
                                    <span class="badge badge-active">Normal</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <a asp-action="Details" asp-route-id="@afiliado.Id" class="btn btn-outline-secondary btn-sm">
                                    Ver
                                </a>
                                <a asp-action="Edit" asp-route-id="@afiliado.Id" class="btn btn-outline-secondary btn-sm">
                                    Editar
                                </a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <button type="button" class="btn btn-danger btn-sm"
                                            onclick="abrirModalEliminar(@afiliado.Id, '@afiliado.Apellido, @afiliado.Nombre')">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="pagination-container">
            <ul class="pagination-custom">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                       asp-route-buscar="@filtroActual">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@filtroActual">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                       asp-route-buscar="@filtroActual">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal de Eliminación -->
<div id="modalEliminar" class="custom-modal-overlay" style="display: none;">
    <div class="custom-modal">
        <h3 class="modal-title">Confirmar Baja</h3>
        <p id="modalTexto" class="modal-desc">¿Está seguro de que desea dar de baja a este afiliado?</p>
        
        <form id="formEliminar" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="afiliadoIdEliminar" name="id" />
            <div class="form-actions" style="margin-top: 20px;">
                <button type="button" class="btn btn-outline-secondary"
                        onclick="cerrarModalEliminar()">Cancelar</button>
                <button type="submit" class="btn btn-danger">Sí, dar de baja</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/alert.js" asp-append-version="true"></script>
    <script>
        function abrirModalEliminar(id, nombreAfiliado) {
            document.getElementById('afiliadoIdEliminar').value = id;
            document.getElementById('modalTexto').innerText = `¿Está seguro de que desea dar de baja a "${nombreAfiliado}"?`;
            document.getElementById('modalEliminar').style.display = 'flex';
        }

        function cerrarModalEliminar() {
            document.getElementById('modalEliminar').style.display = 'none';
        }
    </script>
}