@using BibliotecaPublica.Models
@model BibliotecaPublica.Models.Pago
@{
    var afiliado = (Afiliado)ViewBag.Afiliado;
    var suscripcion = (Suscripcion)ViewBag.Suscripcion;
    ViewData["Title"] = "Registrar pago";
}

<div class="form-card">
    <h3>Registrar pago de cuota</h3>

    <p>
        <strong>Afiliado:</strong> @afiliado.Nombre @afiliado.Apellido<br />
        <strong>Período:</strong> @suscripcion.FechaInicio.ToString("dd/MM/yyyy") al @suscripcion.FechaFin.ToString("dd/MM/yyyy")<br />
        <strong>Monto a cobrar:</strong> $@suscripcion.Monto.ToString("N2")
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdSuscripcion" />

        <div class="form-group mb-3">
            <label asp-for="FechaPago" class="form-label"></label>
            <input asp-for="FechaPago" class="form-control" />
            <span asp-validation-for="FechaPago" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Concepto" class="form-label"></label>
            <input asp-for="Concepto" class="form-control" />
            <span asp-validation-for="Concepto" class="text-danger"></span>
        </div>

        <div class="form-actions d-flex gap-2">
            <button type="submit" class="btn btn-primary">Confirmar pago</button>
            <a asp-controller="Suscripciones" asp-action="Index" asp-route-idAfiliado="@suscripcion.IdAfiliado"
               class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}