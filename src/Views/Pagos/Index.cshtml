@using BibliotecaPublica.Models
@model IEnumerable<BibliotecaPublica.Models.Pago>
@{
    var afiliado = ViewBag.Afiliado as Afiliado;
    int? idAfiliado = ViewBag.IdAfiliado;
    string buscar = ViewBag.Buscar as string ?? "";
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;

    ViewData["Title"] = afiliado != null ? "Pagos del afiliado" : "Pagos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<div class="page-container">
    <div class="page-header">
        <h3>@(afiliado != null ? $"Pagos de {afiliado.Apellido}, {afiliado.Nombre}" : "Pagos")</h3>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="search-bar">
        @if (idAfiliado.HasValue)
        {
            <input type="hidden" name="idAfiliado" value="@idAfiliado" />
        }
        <input type="text" name="buscar" value="@buscar" class="form-control"
               placeholder="@(afiliado != null ? "Buscar por concepto..." : "Buscar por afiliado o concepto...")" />

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(buscar))
        {
            <a asp-action="Index" asp-route-idAfiliado="@idAfiliado" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Fecha</th>
                    @if (afiliado == null)
                    {
                        <th>Afiliado</th>
                    }
                    <th>Tipo</th>
                    <th>Concepto</th>
                    <th>Monto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(afiliado == null ? 6 : 5)" class="text-center py-3">No hay pagos registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                            @if (afiliado == null)
                            {
                                <td class="fw-bold">@p.Afiliado?.Apellido, @p.Afiliado?.Nombre</td>
                            }
                            <td>
                                @if (p.Tipo == TipoPago.Cuota)
                                {
                                    <span class="badge badge-neutral">Cuota</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Multa</span>
                                }
                            </td>
                            <td>@p.Concepto</td>
                            <td>$@p.Monto.ToString("N2")</td>
                            <td class="actions-cell">
                                <button type="button" class="btn-icon btn-icon-danger" title="Anular pago"
                                        data-bs-toggle="modal" data-bs-target="#modalAnularPago" data-id="@p.Id"
                                        data-concepto="@p.Concepto">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="pagination-container">
            <ul class="pagination-custom">
                <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)"
                       asp-route-idAfiliado="@idAfiliado" asp-route-buscar="@buscar">Anterior</a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-idAfiliado="@idAfiliado"
                           asp-route-buscar="@buscar">@i</a>
                    </li>
                }

                <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)"
                       asp-route-idAfiliado="@idAfiliado" asp-route-buscar="@buscar">Siguiente</a>
                </li>
            </ul>
        </nav>
    }

    <div class="form-actions">
        @if (afiliado != null)
        {
            <a asp-controller="Suscripciones" asp-action="Index" asp-route-idAfiliado="@afiliado.Id"
               class="btn btn-outline-secondary">Volver a suscripciones</a>
        }
        <a asp-controller="Afiliados" asp-action="Index" class="btn btn-outline-secondary">Volver a afiliados</a>
    </div>
</div>

<!-- Modal de anulación -->
<div class="modal fade" id="modalAnularPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom text-danger">Anular pago</h3>
            <p id="modalAnularPagoTexto" class="modal-subtitle mb-3">¿Está seguro de que desea anular este pago?</p>

            <form asp-action="Anular" method="post">
                <input type="hidden" id="pagoIdAnular" name="id" />
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Sí, anular</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('modalAnularPago');
            if (!modal) return;

            modal.addEventListener('show.bs.modal', function (event) {
                var boton = event.relatedTarget;
                modal.querySelector('#pagoIdAnular').value = boton.getAttribute('data-id');
                modal.querySelector('#modalAnularPagoTexto').textContent =
                    `¿Está seguro de que desea anular el pago "${boton.getAttribute('data-concepto')}"?`;
            });
        });
    </script>
}