@using BibliotecaPublica.Models
@model List<LibroExterno>
@{
    ViewData["Title"] = "Importar desde Open Library";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h3>Catálogo Global (Open Library)</h3>
            <p class="page-subtitle">Buscá libros en la base de datos mundial e importalos a tu biblioteca.</p>
        </div>
        <a asp-action="Create" class="btn btn-outline-secondary">Carga manual</a>
    </div>

    <partial name="_Alertas" />

    <form asp-action="BuscarExterno" method="get" class="search-bar">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Escribí el título del libro o autor a buscar..." required />

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined icon-inline">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroActual))
        {
            <a asp-action="BuscarExterno" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Portada</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Año</th>
                        <th>ISBN</th>
                        <th>Idioma</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var libro = Model[i];
                        string idForm = $"formImportar-{i}";

                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(libro.PortadaUrl))
                                {
                                    <img src="@libro.PortadaUrl" alt="Portada de @libro.Titulo" class="table-book-cover"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="table-book-placeholder" title="Sin portada">
                                        <span class="material-symbols-outlined">menu_book</span>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold td-wrap">@libro.Titulo</td>
                            <td class="td-wrap">@(libro.AutorNombre ?? "Desconocido")</td>
                            <td>@(libro.Anio?.ToString() ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(libro.Isbn) ? "-" : libro.Isbn)</td>
                            <td>
                                @if (libro.IdiomasDisponibles.Count == 0)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else if (libro.IdiomasDisponibles.Count == 1)
                                {
                                    <span>@libro.IdiomasDisponibles[0]</span>
                                    <input type="hidden" name="Idioma" value="@libro.IdiomasDisponibles[0]" form="@idForm" />
                                }
                                else
                                {
                                    <select name="Idioma" form="@idForm" class="form-control select-compact">
                                        @foreach (var idioma in libro.IdiomasDisponibles)
                                        {
                                            <option value="@idioma">@idioma</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td>
                                <form id="@idForm" asp-action="ImportarExterno" method="post">
                                    <input type="hidden" name="Titulo" value="@libro.Titulo" />
                                    <input type="hidden" name="AutorNombre" value="@libro.AutorNombre" />
                                    <input type="hidden" name="Anio" value="@libro.Anio" />
                                    <input type="hidden" name="Isbn" value="@libro.Isbn" />
                                    <input type="hidden" name="Paginas" value="@libro.Paginas" />
                                    <input type="hidden" name="PortadaUrl" value="@libro.PortadaUrl" />
                                    <input type="hidden" name="Editorial" value="@libro.Editorial" />
                                    <input type="hidden" name="WorkKey" value="@libro.WorkKey" />

                                    <button type="submit" class="btn btn-primary btn-sm">Importar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Paginacion" />
    }
    else if (!string.IsNullOrEmpty(filtroActual))
    {
        <div class="text-center py-5 text-muted">
            <p>No se encontraron resultados en Open Library para "@filtroActual".</p>
            <a asp-action="Create" class="btn btn-primary mt-2">Cargar este libro manualmente</a>
        </div>
    }
</div>