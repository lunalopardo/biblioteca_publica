@using BibliotecaPublica.Models
@model List<LibroExterno>
@{
    ViewData["Title"] = "Importar desde Open Library";
    string filtroExterno = ViewData["FiltroExterno"] as string ?? "";
    int paginaActual = (int)(ViewData["PaginaActual"] ?? 1);
    int totalPaginas = (int)(ViewData["TotalPaginas"] ?? 1);

    int rangoInicio = Math.Max(1, paginaActual - 2);
    int rangoFin = Math.Min(totalPaginas, paginaActual + 2);
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h3>Catálogo Global (Open Library)</h3>
            <p class="page-subtitle">Buscá libros en la base de datos mundial e importalos a tu biblioteca.</p>
        </div>
        <a asp-action="Create" class="btn btn-outline-secondary">Carga manual</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <form asp-action="BuscarExterno" method="get" class="search-bar">
        <input type="text" name="q" value="@filtroExterno" class="form-control"
               placeholder="Escribí el título del libro o autor a buscar..." required />

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined icon-inline">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroExterno))
        {
            <a asp-action="BuscarExterno" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Portada</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Año</th>
                        <th>ISBN</th>
                        <th>Idioma</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var libro = Model[i];
                        string idForm = $"formImportar-{i}";

                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(libro.PortadaUrl))
                                {
                                    <img src="@libro.PortadaUrl" alt="Portada de @libro.Titulo" class="table-book-cover"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="table-book-placeholder">S/P</div>
                                }
                            </td>
                            <td class="fw-bold">@libro.Titulo</td>
                            <td>@(libro.AutorNombre ?? "Desconocido")</td>
                            <td>@(libro.Anio?.ToString() ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(libro.Isbn) ? "-" : libro.Isbn)</td>
                            <td>
                                @if (libro.IdiomasDisponibles.Count == 0)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else if (libro.IdiomasDisponibles.Count == 1)
                                {
                                    <span>@libro.IdiomasDisponibles[0]</span>
                                    <input type="hidden" name="Idioma" value="@libro.IdiomasDisponibles[0]" form="@idForm" />
                                }
                                else
                                {
                                    <select name="Idioma" form="@idForm" class="form-control select-compact">
                                        @foreach (var idioma in libro.IdiomasDisponibles)
                                        {
                                            <option value="@idioma">@idioma</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td>
                                <form id="@idForm" asp-action="ImportarExterno" method="post">
                                    <input type="hidden" name="Titulo" value="@libro.Titulo" />
                                    <input type="hidden" name="AutorNombre" value="@libro.AutorNombre" />
                                    <input type="hidden" name="Anio" value="@libro.Anio" />
                                    <input type="hidden" name="Isbn" value="@libro.Isbn" />
                                    <input type="hidden" name="Paginas" value="@libro.Paginas" />
                                    <input type="hidden" name="PortadaUrl" value="@libro.PortadaUrl" />
                                    <input type="hidden" name="Editorial" value="@libro.Editorial" />
                                    <input type="hidden" name="WorkKey" value="@libro.WorkKey" />

                                    <button type="submit" class="btn btn-primary btn-sm">Importar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <nav class="pagination-container">
                <ul class="pagination-custom">
                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="BuscarExterno" asp-route-q="@filtroExterno"
                           asp-route-pagina="@(paginaActual - 1)">Anterior</a>
                    </li>

                    @if (rangoInicio > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="BuscarExterno" asp-route-q="@filtroExterno"
                               asp-route-pagina="1">1</a>
                        </li>
                        @if (rangoInicio > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (int p = rangoInicio; p <= rangoFin; p++)
                    {
                        <li class="page-item @(p == paginaActual ? "active" : "")">
                            <a class="page-link" asp-action="BuscarExterno" asp-route-q="@filtroExterno"
                               asp-route-pagina="@p">@p</a>
                        </li>
                    }

                    @if (rangoFin < totalPaginas)
                    {
                        @if (rangoFin < totalPaginas - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="BuscarExterno" asp-route-q="@filtroExterno"
                               asp-route-pagina="@totalPaginas">@totalPaginas</a>
                        </li>
                    }

                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="BuscarExterno" asp-route-q="@filtroExterno"
                           asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else if (!string.IsNullOrEmpty(filtroExterno))
    {
        <div class="text-center py-5 text-muted">
            <p>No se encontraron resultados en Open Library para "@filtroExterno".</p>
            <a asp-action="Create" class="btn btn-primary mt-2">Cargar este libro manualmente</a>
        </div>
    }
</div>