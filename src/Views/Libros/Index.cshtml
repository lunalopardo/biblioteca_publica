@model IEnumerable<BibliotecaPublica.Models.Libro>
@{
    ViewData["Title"] = "Listado de Libros";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";

    var autorElegido = ViewBag.Autor as Autor;
    var idiomas = ViewBag.Idiomas as List<string> ?? new List<string>();
    var periodos = ViewBag.Periodos as int[] ?? Array.Empty<int>();
    int? idAutor = ViewBag.IdAutor;
    string? idioma = ViewBag.Idioma;
    int? dias = ViewBag.Dias;
    bool hayFiltros = !string.IsNullOrEmpty(filtroActual) || idAutor.HasValue
                      || !string.IsNullOrEmpty(idioma) || dias.HasValue;

    var ruta = new Dictionary<string, string>();
    if (idAutor.HasValue) ruta["idAutor"] = idAutor.Value.ToString();
    if (!string.IsNullOrEmpty(idioma)) ruta["idioma"] = idioma;
    if (dias.HasValue) ruta["dias"] = dias.Value.ToString();
    ViewData["RutaPaginado"] = ruta;
}

<div class="page-container">
    <div class="page-header">
        <h3>Listado de Libros</h3>
        <div class="d-flex gap-2">
            <a asp-action="BuscarExterno" class="btn btn-outline-secondary">
                <span class="material-symbols-outlined icon-inline">public</span>
                Importar de Open Library
            </a>
            <a asp-action="Create" class="btn btn-primary">
                + Carga Manual
            </a>
        </div>
    </div>

    <partial name="_Alertas" />

    <form asp-action="Index" method="get" class="search-bar search-bar-filtros">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Buscar por título o autor..." />

        <select id="filtroAutor" name="idAutor" class="form-control" aria-label="Autor">
            <option value=""></option>
            @if (autorElegido != null)
            {
                <option value="@autorElegido.Id" selected>@autorElegido.Nombre @autorElegido.Apellido</option>
            }
        </select>

        <select name="idioma" class="form-control" aria-label="Idioma">
            <option value="">Todos los idiomas</option>
            @foreach (var i in idiomas)
            {
                <option value="@i" selected="@(i == idioma)">@i</option>
            }
        </select>

        <select name="dias" class="form-control" aria-label="Más prestados">
            <option value="">Más prestados: todos</option>
            @foreach (var p in periodos)
            {
                <option value="@p" selected="@(p == dias)">Más prestados: @p días</option>
            }
        </select>

        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined icon-inline">search</span>
            <span>Buscar</span>
        </button>

        @if (hayFiltros)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Portada</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Editorial</th>
                    <th>Géneros</th>
                    @if (!dias.HasValue)
                    {
                        <th>Año</th>
                        <th>Páginas</th>
                    }
                    <th class="text-center">Ejemplares</th>
                    @if (dias.HasValue)
                    {
                        <th class="text-center">Préstamos (@dias días)</th>
                    }
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(dias.HasValue ? 8 : 9)" class="text-center py-4 text-muted">No se encontraron libros.</td>
                    </tr>
                }
                else
                {
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(libro.Portada))
                                {
                                    <img src="@libro.Portada" alt="Portada" class="table-book-cover" />
                                }
                                else
                                {
                                    <div class="table-book-placeholder" title="Sin portada">
                                        <span class="material-symbols-outlined">menu_book</span>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-start">@libro.Titulo</td>
                            <td class="td-wrap-sm">@(libro.Autor != null ? $"{libro.Autor.Nombre} {libro.Autor.Apellido}" : "-")</td>
                            <td class="td-wrap-sm">@(libro.Editorial != null ? libro.Editorial.Nombre : "-")</td>
                            <td>
                                <div class="table-generos-container">
                                    @if (libro.Generos != null && libro.Generos.Any())
                                    {
                                        @foreach (var genero in libro.Generos)
                                        {
                                            <span class="badge-genero">@genero.Nombre</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </td>
                            @if (!dias.HasValue)
                            {
                                <td>@(libro.AnioPublicacion?.ToString() ?? "-")</td>
                                <td>@(libro.Paginas?.ToString() ?? "-")</td>
                            }
                            <td class="text-center">
                                <span class="badge-ejemplares">
                                    @(libro.Ejemplares != null ? libro.Ejemplares.Count(e => e.Activo) : 0)
                                </span>
                            </td>
                            @if (dias.HasValue)
                            {
                                <td class="text-center fw-bold">@libro.CantidadPrestamos</td>
                            }
                            <td class="actions-cell">
                                <a asp-action="Details" asp-route-id="@libro.Id" class="btn-icon" title="Ver detalle">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@libro.Id" class="btn-icon" title="Editar">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                @if (User.EsAdministrador())
                                {
                                    <button type="button" class="btn-icon btn-icon-danger" title="Eliminar" data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar" data-id="@libro.Id" data-titulo="@libro.Titulo">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" />
</div>

<!-- Modal de Eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg modal-content-custom">
            <h3 class="modal-title-custom text-danger">Confirmar Baja</h3>
            <p id="modalTexto" class="modal-subtitle mb-3">¿Está seguro de que desea dar de baja este libro?</p>

            <form id="formEliminar" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="libroIdEliminar" name="id" />
                <div class="form-actions mt-4">
                    <button type="submit" class="btn btn-danger">Sí, dar de baja</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
    <script src="~/js/libros-filtros.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEliminar = document.getElementById('modalEliminar');
            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var titulo = button.getAttribute('data-titulo');

                    modalEliminar.querySelector('#libroIdEliminar').value = id;
                    modalEliminar.querySelector('#modalTexto').textContent = `¿Está seguro de que desea dar de baja a "${titulo}"?`;
                });
            }
        });
    </script>
}