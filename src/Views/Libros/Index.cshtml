@model IEnumerable<BibliotecaPublica.Models.Libro>
@{
    ViewData["Title"] = "Listado de Libros";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
    int paginaActual = (int)(ViewData["PaginaActual"] ?? 1);
    int totalPaginas = (int)(ViewData["TotalPaginas"] ?? 1);
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<div class="page-container">
    <div class="page-header">
        <h3>Listado de Libros</h3>
        <div class="d-flex gap-2">
            <a asp-action="BuscarExterno" class="btn btn-outline-secondary">
                <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">public</span>
                Importar de Open Library
            </a>
            <a asp-action="Create" class="btn btn-primary">
                + Carga Manual
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div id="alerta-mensaje" class="alert alert-success text-center">
            @TempData["Mensaje"]
        </div>
    }

    <form asp-action="Index" method="get" class="search-bar">
        <input type="text" name="buscar" value="@filtroActual" class="form-control"
               placeholder="Buscar por título o autor..." />
        
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">search</span>
            <span>Buscar</span>
        </button>

        @if (!string.IsNullOrEmpty(filtroActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Portada</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Editorial</th>
                    <th>Año</th>
                    <th>Páginas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No se encontraron libros registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(libro.Portada))
                                {
                                    <img src="@libro.Portada" alt="Portada"
                                         style="width: 38px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color);" />
                                }
                                else
                                {
                                    <div
                                        style="width: 38px; height: 50px; background-color: var(--color-primary); color: #fff; display: flex; align-items: center; justify-content: center; border-radius: 4px; font-size: 0.7rem; margin: 0 auto;">
                                        S/P
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-start">@libro.Titulo</td>
                            <td>@(libro.Autor != null ? $"{libro.Autor.Apellido}, {libro.Autor.Nombre}" : "-")</td>
                            <td>@(libro.Editorial != null ? libro.Editorial.Nombre : "-")</td>
                            <td>@(libro.AnioPublicacion?.ToString() ?? "-")</td>
                            <td>@(libro.Paginas?.ToString() ?? "-")</td>
                            <td class="actions-cell">
                                <a asp-action="Details" asp-route-id="@libro.Id" class="btn-icon" title="Ver detalle">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@libro.Id" class="btn-icon" title="Editar">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                <button type="button" class="btn-icon btn-icon-danger" title="Eliminar" data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar" data-id="@libro.Id" data-titulo="@libro.Titulo">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="pagination-container">
            <ul class="pagination-custom">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                       asp-route-buscar="@filtroActual">Anterior</a>
                </li>
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@filtroActual">@i</a>
                    </li>
                }
                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                       asp-route-buscar="@filtroActual">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal de Eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content form-card border-0 shadow-lg" style="margin: 0; max-width: 100%;">
            <h3 class="modal-title-custom text-danger">Confirmar Baja</h3>
            <p id="modalTexto" class="modal-subtitle mb-3">¿Está seguro de que desea dar de baja este libro?</p>
            
            <form id="formEliminar" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="libroIdEliminar" name="id" />
                <div class="form-actions mt-4">
                    <button type="submit" class="btn btn-danger">Sí, dar de baja</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/alert.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEliminar = document.getElementById('modalEliminar');
            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var titulo = button.getAttribute('data-titulo');

                    modalEliminar.querySelector('#libroIdEliminar').value = id;
                    modalEliminar.querySelector('#modalTexto').textContent = `¿Está seguro de que desea dar de baja a "${titulo}"?`;
                });
            }
        });
    </script>
}