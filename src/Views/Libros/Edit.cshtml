@using BibliotecaPublica.Models
@model BibliotecaPublica.Models.Libro
@{
    ViewData["Title"] = "Editar Libro";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="form-card" style="max-width: 750px;">
    <div class="card-header-flex">
        <h3>Editar Libro</h3>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Portada" />

        <div class="form-group text-center mb-4">
            <label class="form-label d-block">Portada del Libro</label>
            
            <img id="imgPreview" src="@(string.IsNullOrEmpty(Model.Portada) ? "#" : Model.Portada)" alt="Portada"
                 class="mb-3 book-cover-preview @(string.IsNullOrEmpty(Model.Portada) ? "is-hidden" : "")" />

            <div id="portadaPlaceholder"
                 class="text-muted mb-3 book-preview-placeholder @(!string.IsNullOrEmpty(Model.Portada) ? "is-hidden" : "")">
                Sin portada registrada
            </div>

            <div>
                <label for="PortadaFile" class="btn btn-outline-secondary btn-sm">
                    Cambiar Portada
                </label>
                <input asp-for="PortadaFile" type="file" accept="image/*" class="is-hidden" id="PortadaFile"
                       onchange="previewImage(event)" />
            </div>
            <span asp-validation-for="PortadaFile" class="mensaje-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" required />
            <span asp-validation-for="Titulo" class="mensaje-error"></span>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="IdAutor" class="form-label">Autor</label>
                <select asp-for="IdAutor" class="form-control" id="IdAutor" required>
                    @if (Model.Autor != null)
                    {
                        <option value="@Model.IdAutor" selected>@Model.Autor.Apellido, @Model.Autor.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdAutor" class="mensaje-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdEditorial" class="form-label">Editorial</label>
                <select asp-for="IdEditorial" class="form-control" id="IdEditorial">
                    @if (Model.Editorial != null)
                    {
                        <option value="@Model.IdEditorial" selected>@Model.Editorial.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdEditorial" class="mensaje-error"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="GenerosSeleccionados" class="form-label">Géneros</label>
            <select asp-for="GenerosSeleccionados" class="form-control" id="GenerosSeleccionados" multiple="multiple">
                @if (ViewBag.Generos != null)
                {
                    foreach (var genero in (List<Genero>)ViewBag.Generos)
                    {
                        bool seleccionado = Model.GenerosSeleccionados != null &&
                Model.GenerosSeleccionados.Contains(genero.Id);
                        <option value="@genero.Id" selected="@seleccionado">@genero.Nombre</option>
                    }
                }
            </select>
            <span asp-validation-for="GenerosSeleccionados" class="text-danger"></span>
        </div>

        <div class="form-grid-3">
            <div class="form-group">
                <label asp-for="Isbn" class="form-label">ISBN</label>
                <input asp-for="Isbn" class="form-control" />
                <span asp-validation-for="Isbn" class="mensaje-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Paginas" class="form-label"></label>
                <input asp-for="Paginas" type="number" class="form-control" />
                <span asp-validation-for="Paginas" class="mensaje-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnioPublicacion" class="form-label"></label>
                <input asp-for="AnioPublicacion" type="number" class="form-control" />
                <span asp-validation-for="AnioPublicacion" class="mensaje-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>

    <script>
        function previewImage(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const imgPreview = document.getElementById('imgPreview');
                    const placeholder = document.getElementById('portadaPlaceholder');
                    imgPreview.src = e.target.result;
                    imgPreview.classList.remove('is-hidden');
                    if (placeholder) {
                        placeholder.classList.add('is-hidden');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        $(document).ready(function () {

            // SELECT2 PARA AUTORES
            $('#IdAutor').select2({
                language: "es",
                placeholder: "Escriba para buscar autor...",
                minimumInputLength: 1,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Autores/Buscar?q=${q}`;
                    },
                    processResults: function (res) {
                        return {
                            results: res.map(i => ({ id: i.id, text: i.text }))
                        };
                    }
                }
            });

            // SELECT2 PARA EDITORIALES
            $('#IdEditorial').select2({
                language: "es",
                placeholder: "Escriba para buscar editorial...",
                minimumInputLength: 1,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Editoriales/Buscar?q=${q}`;
                    },
                    processResults: function (res) {
                        return {
                            results: res.map(i => ({ id: i.id, text: i.text }))
                        };
                    }
                }
            });

            // SELECT2 PARA GÉNEROS (MÚLTIPLE)
            $('#GenerosSeleccionados').select2({
                language: "es",
                placeholder: "Seleccione o busque los géneros..."
            });
        });
    </script>
}