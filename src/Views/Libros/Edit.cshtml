@using BibliotecaPublica.Models
@model BibliotecaPublica.Models.Libro
@{
    ViewData["Title"] = "Editar Libro";
}

<div class="form-card form-card-medium">
    <div class="card-header-flex">
        <h3>Editar Libro</h3>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        @await Html.PartialAsync("_SelectorImagen", new SelectorImagen
        {
            Titulo = "Portada del Libro", Nombre = "Portada", Campo = "PortadaFile", CampoEliminar = "EliminarPortada", Icono = "menu_book",
            ImagenActual = Model.Portada, EsPortada = true
        })

        <div class="form-group">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" required />
            <span asp-validation-for="Titulo" class="mensaje-error"></span>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="IdAutor" class="form-label">Autor</label>
                <select asp-for="IdAutor" class="form-control" id="IdAutor" required>
                    @if (Model.Autor != null)
                    {
                        <option value="@Model.IdAutor" selected>@Model.Autor.Nombre @Model.Autor.Apellido</option>
                    }
                </select>
                <span asp-validation-for="IdAutor" class="mensaje-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdEditorial" class="form-label">Editorial</label>
                <select asp-for="IdEditorial" class="form-control" id="IdEditorial">
                    @if (Model.Editorial != null)
                    {
                        <option value="@Model.IdEditorial" selected>@Model.Editorial.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdEditorial" class="mensaje-error"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="GenerosSeleccionados" class="form-label">Géneros</label>
            <select asp-for="GenerosSeleccionados" class="form-control" id="GenerosSeleccionados" multiple="multiple">
                @if (ViewBag.Generos != null)
                {
                    foreach (var genero in (List<Genero>)ViewBag.Generos)
                    {
                        bool seleccionado = Model.GenerosSeleccionados != null &&
                                            Model.GenerosSeleccionados.Contains(genero.Id);
                        <option value="@genero.Id" selected="@seleccionado">@genero.Nombre</option>
                    }
                }
            </select>
            <span asp-validation-for="GenerosSeleccionados" class="mensaje-error"></span>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Isbn" class="form-label">ISBN</label>
                <input asp-for="Isbn" class="form-control" />
                <span asp-validation-for="Isbn" class="mensaje-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Idioma" class="form-label"></label>
                <input asp-for="Idioma" class="form-control" list="idiomas-sugeridos" placeholder="Ej. Español" />
                <datalist id="idiomas-sugeridos">
                    <option value="Español"></option>
                    <option value="Inglés"></option>
                    <option value="Francés"></option>
                    <option value="Portugués"></option>
                    <option value="Italiano"></option>
                    <option value="Alemán"></option>
                </datalist>
                <span asp-validation-for="Idioma" class="mensaje-error"></span>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Paginas" class="form-label"></label>
                <input asp-for="Paginas" type="number" class="form-control" />
                <span asp-validation-for="Paginas" class="mensaje-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnioPublicacion" class="form-label"></label>
                <input asp-for="AnioPublicacion" type="number" class="form-control" />
                <span asp-validation-for="AnioPublicacion" class="mensaje-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="5000"
                      placeholder="Sinopsis o breve descripción del libro..."></textarea>
            <span asp-validation-for="Descripcion" class="mensaje-error"></span>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
    <script src="~/js/libros-form.js" asp-append-version="true"></script>
}